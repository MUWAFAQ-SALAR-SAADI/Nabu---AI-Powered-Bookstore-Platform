    "from tqdm import tqdm\n",
    "from transformers import pipeline\n",
    "import pandas as pd\n",
    "import os\n",
    "\n",
    "# إعداد المصنّف\n",
    "classifier = pipeline(\n",
    "    \"zero-shot-classification\",\n",
    "    model=\"facebook/bart-large-mnli\",\n",
    "    device=-1  # CPU\n",
    ")\n",
    "\n",
    "# فئات المشاعر\n",
    "emotion_labels = [\"anger\", \"disgust\", \"fear\", \"joy\", \"sadness\", \"surprise\", \"neutral\"]\n",
    "\n",
    "# دالة لحساب أعلى الاحتمالات لكل فئة\n",
    "def calculate_max_emotion_scores(predictions):\n",
    "    max_scores = {label: 0.0 for label in emotion_labels}\n",
    "    for pred in predictions:\n",
    "        for label, score in zip(pred['labels'], pred['scores']):\n",
    "            if score > max_scores[label]:\n",
    "                max_scores[label] = score\n",
    "    return max_scores\n",
    "\n",
    "# لو فيه ملف نتائج سابق نكمل منه\n",
    "save_file = \"emotion_scores_partial.csv\"\n",
    "if os.path.exists(save_file):\n",
    "    df_existing = pd.read_csv(save_file)\n",
    "    processed_isbns = set(df_existing[\"isbn13\"])\n",
    "    emotion_scores = df_existing.to_dict(orient=\"list\")\n",
    "    isbn = emotion_scores.pop(\"isbn13\")\n",
    "else:\n",
    "    df_existing = None\n",
    "    processed_isbns = set()\n",
    "    isbn = []\n",
    "    emotion_scores = {label: [] for label in emotion_labels}\n",
    "\n",
    "# معالجة الكتب\n",
    "for i in tqdm(range(len(books))):\n",
    "    book_id = books[\"isbn13\"][i]\n",
    "    if book_id in processed_isbns:\n",
    "        continue  # هذا الكتاب معالج مسبقاً\n",
    "\n",
    "    sentences = [s.strip() for s in books[\"description\"][i].split(\".\") if s.strip()]\n",
    "\n",
    "    # تصنيف كل الجمل دفعة واحدة\n",
    "    predictions = classifier(sentences, candidate_labels=emotion_labels, multi_label=True)\n",
    "\n",
    "    # حساب أعلى الاحتمالات لكل فئة\n",
    "    max_scores = calculate_max_emotion_scores(predictions)\n",
    "\n",
    "    isbn.append(book_id)\n",
    "    for label in emotion_labels:\n",
    "        emotion_scores[label].append(max_scores[label])\n",
    "\n",
    "    # حفظ كل 100 كتاب\n",
    "    if len(isbn) % 100 == 0:\n",
    "        df_emotions = pd.DataFrame(emotion_scores)\n",
    "        df_emotions[\"isbn13\"] = isbn\n",
    "        df_emotions.to_csv(save_file, index=False)\n",
    "        print(f\"✅ Progress saved at {len(isbn)} books\")\n",
    "\n",
    "# الحفظ النهائي\n",
    "df_emotions = pd.DataFrame(emotion_scores)\n",
    "df_emotions[\"isbn13\"] = isbn\n",
    "df_emotions.to_csv(save_file, index=False)\n",
    "print(\"🎉 Finished and saved all results\")\n"
   ],

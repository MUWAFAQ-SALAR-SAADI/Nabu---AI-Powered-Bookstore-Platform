    "# 1️⃣ استيراد الحزم اللازمة\n",
    "from langchain_community.document_loaders import TextLoader\n",
    "from langchain_text_splitters import CharacterTextSplitter\n",
    "from langchain.embeddings import HuggingFaceEmbeddings\n",
    "from langchain.vectorstores import Chroma\n",
    "import pandas as pd"
   ],
   "id": "1e2e9167f99be6b",
   "execution_count": null,
   "outputs": []
  },
  {
   "metadata": {},
   "cell_type": "code",
   "execution_count": null,
   "source": [
    "\n",
    "# 2️⃣ تحميل ملف CSV\n",
    "books = pd.read_csv(\"books_cleaned.csv\")\n",
    "\n",
    "# التأكد أن العمود موجود\n",
    "if \"tagged_description\" not in books.columns:\n",
    "    raise ValueError(\"Column 'tagged_description' does not exist in the DataFrame.\")"
   ],
   "id": "effdf7fca347f509",
   "outputs": []
  },
  {
   "metadata": {},
   "cell_type": "code",
   "execution_count": null,
   "source": [
    "\n",
    "# 3️⃣ حفظ كل وصف في سطر منفصل في ملف txt\n",
    "with open(\"tagged_description.txt\", \"w\", encoding=\"utf-8\") as f:\n",
    "    for desc in books[\"tagged_description\"].astype(str):\n",
    "        f.write(desc.strip() + \"\\n\")\n",
    "\n",
    "print(\"File 'tagged_description.txt' created successfully!\")"
   ],
   "id": "69d24c29fd1d1ed8",
   "outputs": []
  },
  {
   "metadata": {},
   "cell_type": "code",
   "execution_count": null,
   "source": [
    "\n",
    "# 4️⃣ تحميل النصوص من الملف\n",
    "raw_documents = TextLoader(\"tagged_description.txt\", encoding=\"utf-8\").load()"
   ],
   "id": "d1c17945326e0488",
   "outputs": []
  },
  {
   "metadata": {},
   "cell_type": "code",
   "execution_count": null,
   "source": [
    "\n",
    "# 5️⃣ تقسيم النصوص إلى chunks\n",
    "text_splitter = CharacterTextSplitter(\n",
    "    chunk_size=500,    # حجم كل جزء\n",
    "    chunk_overlap=50,  # التداخل بين الأجزاء\n",
    "    separator=\"\\n\"\n",
    ")\n",
    "documents = text_splitter.split_documents(raw_documents)\n",
    "print(f\"Loaded {len(documents)} documents successfully!\")"
   ],
   "id": "97f8bc3d71c8f069",
   "outputs": []
  },
  {
   "metadata": {},
   "cell_type": "code",
   "execution_count": null,
   "source": [
    "\n",
    "# 6️⃣ إنشاء embeddings باستخدام HuggingFace\n",
    "embedding_model = HuggingFaceEmbeddings(model_name=\"sentence-transformers/all-MiniLM-L6-v2\")"
   ],
   "id": "44b1e882415c1046",
   "outputs": []
  },
  {
   "metadata": {},
   "cell_type": "code",
   "execution_count": null,
   "source": [
    "\n",
    "# 7️⃣ إنشاء قاعدة بيانات Chroma من النصوص\n",
    "db_books = Chroma.from_documents(\n",
    "    documents,\n",
    "    embedding=embedding_model,\n",
    "    persist_directory=\"chroma_books\"  # تحفظ قاعدة البيانات على الجهاز\n",
    ")\n",
    "print(\"Chroma database created successfully!\")"
   ],
   "id": "a2c9f8466458709e",
   "outputs": []
  },
  {
   "metadata": {},
   "cell_type": "code",
   "execution_count": null,
   "source": [
    "\n",
    "# 8️⃣ مثال على البحث\n",
    "query = \"A book to teach children about nature\"\n",
    "docs = db_books.similarity_search(query, k=10)\n",
    "print(\"Top document content:\\n\", docs[0].page_content)"
   ],
   "id": "c34793d1e330aaf6",
   "outputs": []
  },
  {
   "metadata": {},
   "cell_type": "code",
   "execution_count": null,
   "source": [
    "\n",
    "# 9️⃣ استرجاع البيانات من CSV بناءً على النتائج\n",
    "isbn_match = int(docs[0].page_content.split()[0].strip())\n",
    "print(books[books[\"isbn13\"] == isbn_match])"
   ],
